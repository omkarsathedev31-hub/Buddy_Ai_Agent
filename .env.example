# GEMINI_API_KEY: Required for server-side Gemini AI Buddy and scam analysis.
# Set in AI Studio Settings > Secrets, local .env / .env.local, or backend host Environment Variables.
# Paste the key as ONE line with no spaces. Quotes are optional.
# Local development: the value saved in .env.local / .env wins over an older GEMINI_API_KEY left in your
# shell/OS environment (a notice naming the variable is printed). Restart `npm run dev` after editing.
# Vercel/hosts: environment variable changes only apply to NEW deployments - redeploy after editing.
# Check your setup (never prints the key): npm run diagnose:gemini
GEMINI_API_KEY="your-gemini-api-key"

# GEMINI_MODEL: Optional model override (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# PORT: Backend HTTP server port (defaults to 3000 locally).
PORT="3000"

# APP_URL: The public URL where this application is hosted (used for HTTPS cookie checks and CORS).
APP_URL="http://localhost:3000"

# BUDDY_MESSAGING_NUMBER: Official E.164 phone number with country code for Buddy Elder AI messaging onboarding.
# Must include '+' and country code (8 to 15 digits total).
BUDDY_MESSAGING_NUMBER="your-messaging-number-with-country-code"

# ADMIN_PASSCODE: Server-side only passcode for Administrator authentication.
# NEVER prefix with VITE_ or NEXT_PUBLIC_. Keep secret on the server only.
ADMIN_PASSCODE="your-strong-admin-passcode"

# BUDDY_DB_PATH: Optional custom SQLite database file path (defaults to ./data/buddy-elder.db locally).
# IMPORTANT: Do NOT rely on Vercel ephemeral /tmp for permanent SQLite data in production.
# Host the Express server on a persistent Node.js host (Render / Railway / Fly.io / VPS) with a persistent volume.
BUDDY_DB_PATH=""

# ALLOWED_ORIGINS: Comma-separated frontend origins allowed for cross-origin API requests (required when frontend is on Vercel and Express is hosted separately).
# Example: ALLOWED_ORIGINS="https://your-app.vercel.app,http://localhost:5173"
ALLOWED_ORIGINS=""

# VITE_API_BASE_URL: Public backend API URL when deploying the React frontend separately from Express (e.g. https://your-backend.onrender.com).
# Leave blank for same-origin deployments (npm run dev / npm run start). Never set to localhost in production builds, and never put secrets in VITE_* variables.
VITE_API_BASE_URL=""

